# Required for sign-in. Keep these private.
# AUTH_USERNAME / AUTH_PASSWORD become the first admin.
# ADMIN_USERNAME / ADMIN_PASSWORD are detected as admin on sign-in and open /admin.
# More users are managed in /admin and saved in data/studio.json.
AUTH_SECRET=
AUTH_USERNAME=admin
AUTH_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional legacy xAI key (no longer required for mockups).
XAI_API_KEY=

# Free Groq key(s) for auto filename, listing SEO, keywords, and mockup photo reading.
# Multiple keys: comma-separated. On rate-limit the next key is tried.
# https://console.groq.com/keys
GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3

# Cloudflare Workers AI for Flux 2 Dev product-reference mockups.
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

