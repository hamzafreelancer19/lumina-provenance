# Local Diffusers worker
HOST=127.0.0.1
PORT=8000

# cuda | cpu | mps | auto
DEVICE=auto

# Hugging Face model id or local folder with model weights
MODEL_PATH=runwayml/stable-diffusion-v1-5

# Where jobs and outputs are stored
JOBS_DIR=./jobs

# Optional: force lightweight empty scenes without Diffusers (API smoke tests)
# FORCE_SIMPLE_BACKGROUNDS=0
